#!/usr/bin/env php
<?php

// phpcs:ignoreFile Symfony.Files.AlphanumericFilename.Invalid

declare(strict_types=1);

/** @noinspection SuspiciousBinaryOperationInspection */
require $_composer_autoload_path ?? __DIR__.'/../vendor/autoload.php';

use Simbiat\QARunner\Console\Application;

try {
    exit(new Application()->run());
    // phpcs:ignore SlevomatCodingStandard.Namespaces.FullyQualifiedExceptions.NonFullyQualifiedException
} catch (Throwable $throwable) {
    echo "Failed to run QA Runner tests.\n".$throwable->getMessage()."\n".$throwable->getTraceAsString()."\n";
    exit(2);
}
